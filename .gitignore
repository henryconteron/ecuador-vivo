# Archivos del sistema y del editor
.DS_Store
Thumbs.db
.vscode/
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]

# Archivos temporales de QGIS
*.qgz~
*.qgs~

# Biblioteca privada y renders efímeros de revisión.
# El repositorio conserva citas, DOI y metadatos; no distribuye PDFs completos.
/documentation/references/*.pdf
/tmp/

# Datos pesados de trabajo (no publicar en GitHub)
data/raw/
assets/images/raw/
*.tif
*.tiff
*.las
*.laz
*.psx
*.psz
*.files/

# Variables privadas
.env
.env.*

# Producción local y preservación de la migración (no publicar)
/_local/
/production/artifacts/
/production/monitor/.venv/
/production/monitor/artifacts/
/production/monitor/.streamlit/secrets.toml
/tools/biblioteca/original/data/posts.json
/output/conceptos-ecuador-vivo-20261004/

# Producción audiovisual pendiente de publicación: conservar solo localmente.
/videos/
.hyperframes/
/tests/test_enso_*.py
/tests/test_expedicion_*.py
/tests/test_expedicion_*.mjs
/dev/*enso*
/dev/*expedicion*
/dev/*social_pilots*

# Metadatos regenerables e instalaciones; no son código fuente.
*.egg-info/
*.egg
.venv/
*.log
*.tmp
*.bak
*.orig
*.pem
*.key

# No admitir nuevos videos, voces ni paquetes de entrega por accidente.
# Las piezas públicas ya versionadas no se retiran con estas reglas.
*.mp4
*.mov
*.webm
*.mp3
*.wav
*.zip
